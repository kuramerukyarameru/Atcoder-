template<class mint>
struct Comb{
    vector<mint> fact,ifact;
    Comb(int N):fact(N+1),ifact(N+1){
        fact[0]=1;
        for(int i=1;i<=N;i++){
            fact[i]=fact[i-1]*i;
        }
        ifact[N]=fact[N].inv();
        for(int i=N;i>=1;i--){
            ifact[i-1]=ifact[i]*i;
        }
    }
    // nCr
    mint C(int n,int r){
        if(r<0||n<r)return 0;
        return fact[n]*ifact[r]*ifact[n-r];;
    }
    //nPr
    mint P(int n,int r){
        if(r<0||n<r)return 0;
        return fact[n]*ifact[n-r];
    }
    //nHr
    mint H(int n,int r){
        if(n==0&&r==0)return 1;
        if(r<0)return 0;
        return C(n+r-1,r);
    }
};
